# Optional public app configuration. Blank means local-only.
# Copy to .env locally; never add server secrets to EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=
EXPO_PUBLIC_MEMBERSHIP_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
# Analysis session token is injected by tools/replay_analysis/start-expo.cjs.
# Provider keys belong only in the Python server environment (see tools/replay_analysis/coach.env.example).
# Coach remote UI and protected chat route; disabled until server/account setup is ready.
EXPO_PUBLIC_COACH_REMOTE_ENABLED=false
# Local debug-only accountless testing also requires server ALLOW_DEV_AI=1.
EXPO_PUBLIC_COACH_DEV_ENABLED=false

# Development-only tools. Never enable in the shipping app. Restart Metro after changing.
EXPO_PUBLIC_DEVELOPER_FEATURES=false
# Optional HTTPS matching source clip for authored replay demo (not bundled).
EXPO_PUBLIC_REPLAY_SAMPLE_URL=
