{
  "cli": {
    "version": ">= 27.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "analysis-validation": {
      "extends": "production",
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "cache": {
        "key": "analysis-swiftpm-rnfb27-firebase13-v1",
        "paths": ["ios/.swiftpm-cache"]
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      },
      "env": {
        "GYM_USE_SYSTEM_SCM": "true",
        "GYM_CLONED_SOURCE_PACKAGES_PATH": ".swiftpm-cache/source-packages",
        "GYM_PACKAGE_CACHE_PATH": ".swiftpm-cache/package-cache",
        "EXPO_PUBLIC_HOSTED_ANALYSIS_ENABLED": "true",
        "EXPO_PUBLIC_HOSTED_ANALYSIS_URL": "https://breakaway-analysis-467843664681.us-west1.run.app"
      }
    },
    "production": {
      "node": "24.12.0",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_HOSTED_ANALYSIS_ENABLED": "false",
        "EXPO_PUBLIC_DEVELOPER_FEATURES": "false",
        "EXPO_PUBLIC_COACH_REMOTE_ENABLED": "false",
        "EXPO_PUBLIC_COACH_DEV_ENABLED": "false",
        "EXPO_PUBLIC_SHOT_POSE_ANALYSIS": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6832437565"
      }
    }
  }
}
