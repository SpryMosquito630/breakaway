# Copy to work/replay-service/coach.env.local (ignored), chmod 600, and edit locally.
# Server only: never put this key in EXPO_PUBLIC_* or paste it into chat.
GEMINI_API_KEY=
# Stable text+structured-output model verified in Google's docs, November 2026.
GEMINI_MODEL=gemini-3.8-flash
# Normal account-authenticated mode; configure these before sharing remotely.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Explicit local debug tests only: 1 permits five total attempts per server run.
# Requires EXPO_PUBLIC_COACH_DEV_ENABLED=true in a debug app; never shared tunnel.
ALLOW_DEV_AI=0
